# Zoom Marketplace > Develop > Build App > Meeting SDK app > App Credentials
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# Secret used to sign app login tokens (long random string). Random per-start if unset.
APP_JWT_SECRET=
# Key that lets a user log in as admin. If unset, nobody can become admin.
ADMIN_KEY=
# Set to true to require a Bearer token on /zoom/signature.
REQUIRE_AUTH=false
# SQLite file path (defaults to data.db next to main.py).
DB_PATH=
